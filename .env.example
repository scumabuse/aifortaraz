# Integration root environment: the single source of the AI key and the URLs (integration spec 7.2).
# `make init` creates .env from this file, generates the secrets, and copies .env into
# aifortaraz/safety-inspector/.env and safety-ai/.env. Edit only the root .env, then run `make init` again.

# ---- shared by both halves ----
# 32 random characters generated by make init; the website seeds its "ai-module" API key with this value.
SEED_AI_API_KEY=
# The same value; the AI module sends it as X-API-Key and as ?api_key= on /ws/ingest.
SAFETY_AI_API_KEY=
# Where the AI module finds the website backend (inside docker compose: http://backend:8000).
SAFETY_AI_BACKEND_URL=http://127.0.0.1:8000
# Website demo mode: seeds the four demo cameras and runs the mock generator for cameras without AI.
DEMO_MODE=true
# Base URL the browser uses for the AI's annotated MJPEG; seeded into the camera cards of AI_CAMERAS.
AI_MJPEG_BASE_URL=http://localhost:8001
# Cameras processed by the AI module (the website seeds them as AI-enabled MJPEG cameras).
AI_CAMERAS=cam-1,cam-2
# Optional Telegram bot for `make demo-preset` (token from @BotFather, comma-separated chat ids).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Local time of the plant: zone schedules on both sides.
TZ=Asia/Yekaterinburg

# ---- website backend ----
DATABASE_URL=sqlite:///./data/inspector.db
DATA_DIR=./data
# 64 hex characters generated by make init.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DEMO_AUTOSTART=true
