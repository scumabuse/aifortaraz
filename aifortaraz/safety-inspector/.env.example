DATABASE_URL=sqlite:///./data/inspector.db
DATA_DIR=./data
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DEMO_MODE=true
DEMO_AUTOSTART=true
# API key of the AI module (X-API-Key). Empty: a random key is created once,
# printed and saved to .secrets/ai_api_key.
SEED_AI_API_KEY=
# Comma-separated camera ids whose video comes from the AI module (for example cam-1,cam-2);
# they are seeded even with DEMO_MODE=false and point to <AI_MJPEG_BASE_URL>/stream/<id>.mjpeg.
AI_CAMERAS=
# Must be reachable from the browser (localhost with a port mapping under Docker).
AI_MJPEG_BASE_URL=http://localhost:8001
# Docker only: time zone of the containers (logs); the site uses its own timezone setting.
# TZ=Asia/Yekaterinburg
