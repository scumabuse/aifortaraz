  },
  "additionalProperties": false,
  "description": "Body of ``POST /api/v1/ingest/events`` (the ``payload`` form field, or the JSON body).",
  "properties": {
    "external_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "External Id",
      "type": "string"
    },
    "camera_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Camera Id",
      "type": "string"
    },
    "zone_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Zone Id"
    },
    "type": {
      "enum": [
        "ppe_violation",
        "zone_intrusion",
        "vehicle_proximity",
        "fall_detected",
        "person_immobile",
        "overcrowding",
        "custom"
      ],
      "title": "Type",
      "type": "string"
    },
    "severity": {
      "anyOf": [
        {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Severity"
    },
    "confidence": {
      "title": "Confidence",
      "type": "number"
    },
    "track_id": {
      "minimum": 0,
      "title": "Track Id",
      "type": "integer"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ended At"
    },
    "details": {
      "anyOf": [
        {
          "$ref": "#/$defs/PpeViolationDetails"
        },
        {
          "$ref": "#/$defs/ZoneIntrusionDetails"
        },
        {
          "$ref": "#/$defs/VehicleProximityDetails"
        },
        {
          "$ref": "#/$defs/FallDetectedDetails"
        },
        {
          "$ref": "#/$defs/PersonImmobileDetails"
        },
        {
          "$ref": "#/$defs/OvercrowdingDetails"
        },
        {
          "$ref": "#/$defs/CustomDetails"
        }
      ],
      "title": "Details"
    }
  },
  "required": [
    "external_id",
    "camera_id",
    "zone_id",
    "type",
    "severity",
    "confidence",
    "track_id",
    "started_at",
    "ended_at",
    "details"
  ],
  "title": "EventPayload",
  "type": "object"
}
