            },
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            }
          ],
          "title": "Frame Size",
          "type": "array"
        }
      },
      "required": [
        "count",
        "max_persons",
        "boxes",
        "frame_size"
      ],
      "title": "OvercrowdingDetails",
      "type": "object"
    },
    "PersonImmobileDetails": {
      "additionalProperties": false,
      "description": "``details`` of a ``person_immobile`` event.",
      "properties": {
        "immobile_sec": {
          "minimum": 0.0,
