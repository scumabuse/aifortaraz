      ],
      "title": "PersonImmobileDetails",
      "type": "object"
    },
    "PpeViolationDetails": {
      "additionalProperties": false,
      "description": "``details`` of a ``ppe_violation`` event.",
      "properties": {
        "missing_ppe": {
          "items": {
            "enum": [
              "helmet",
              "vest",
              "glasses",
              "gloves",
              "mask",
              "boots",
              "earmuffs",
              "harness",
              "face_shield"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Missing Ppe",
          "type": "array"
        },
        "present_ppe": {
          "items": {
            "enum": [
              "helmet",
              "vest",
              "glasses",
              "gloves",
              "mask",
              "boots",
              "earmuffs",
              "harness",
              "face_shield"
            ],
            "type": "string"
          },
          "title": "Present Ppe",
          "type": "array"
        },
        "boxes": {
          "items": {
            "$ref": "#/$defs/Box"
          },
          "minItems": 1,
          "title": "Boxes",
          "type": "array"
        },
        "frame_size": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "exclusiveMinimum": 0,
