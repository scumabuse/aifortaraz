{
  "$defs": {
    "Box": {
      "additionalProperties": false,
      "description": "One box in ``details.boxes``; PPE item boxes carry the owning person's track id.",
      "properties": {
        "track_id": {
          "minimum": 0,
          "title": "Track Id",
          "type": "integer"
        },
        "label": {
          "enum": [
            "person",
            "vehicle",
            "forklift",
            "truck",
            "car",
            "helmet",
            "vest",
            "glasses",
            "gloves",
            "mask",
            "boots",
            "earmuffs",
            "harness",
            "face_shield",
            "head",
            "face",
            "hands",
            "foot",
            "ear"
          ],
          "title": "Label",
          "type": "string"
        },
        "bbox": {
          "items": {
            "type": "number"
          },
          "title": "Bbox",
          "type": "array"
        },
        "conf": {
          "title": "Conf",
          "type": "number"
        }
      },
      "required": [
        "track_id",
        "label",
        "bbox",
        "conf"
      ],
      "title": "Box",
      "type": "object"
    },
    "CustomDetails": {
      "additionalProperties": false,
      "description": "``details`` of a ``custom`` event.",
      "properties": {
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "boxes": {
          "items": {
            "$ref": "#/$defs/Box"
          },
          "minItems": 1,
          "title": "Boxes",
          "type": "array"
        },
        "frame_size": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            }
          ],
          "title": "Frame Size",
          "type": "array"
        }
      },
      "required": [
        "title",
        "boxes",
        "frame_size"
      ],
      "title": "CustomDetails",
      "type": "object"
    },
    "FallDetectedDetails": {
      "additionalProperties": false,
      "description": "``details`` of a ``fall_detected`` event.",
      "properties": {
        "pose_conf": {
          "maximum": 1.0,
