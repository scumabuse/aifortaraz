          "title": "Pose Conf",
          "type": "number"
        },
        "boxes": {
          "items": {
            "$ref": "#/$defs/Box"
          },
          "minItems": 1,
          "title": "Boxes",
          "type": "array"
        },
        "frame_size": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            }
          ],
          "title": "Frame Size",
          "type": "array"
        }
      },
      "required": [
        "pose_conf",
        "boxes",
        "frame_size"
      ],
      "title": "FallDetectedDetails",
      "type": "object"
    },
    "OvercrowdingDetails": {
      "additionalProperties": false,
      "description": "``details`` of an ``overcrowding`` event.",
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "max_persons": {
          "minimum": 0,
          "title": "Max Persons",
          "type": "integer"
        },
        "boxes": {
          "items": {
            "$ref": "#/$defs/Box"
          },
          "minItems": 1,
          "title": "Boxes",
          "type": "array"
        },
        "frame_size": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "exclusiveMinimum": 0,
