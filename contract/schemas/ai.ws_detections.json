{
  "$defs": {
    "PersonObject": {
      "additionalProperties": false,
      "description": "A person in a ``detections`` message; ``ppe`` holds only the required items.",
      "properties": {
        "track_id": {
          "minimum": 0,
          "title": "Track Id",
          "type": "integer"
        },
        "label": {
          "const": "person",
          "title": "Label",
          "type": "string"
        },
        "bbox": {
          "items": {
            "type": "number"
          },
          "title": "Bbox",
          "type": "array"
        },
        "conf": {
          "title": "Conf",
          "type": "number"
        },
        "ppe": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "enum": [
              "helmet",
              "vest",
              "glasses",
              "gloves",
              "mask",
              "boots",
              "earmuffs",
              "harness",
              "face_shield"
            ]
          },
          "title": "Ppe",
          "type": "object"
        },
        "zones": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "title": "Zones",
          "type": "array"
        },
        "state": {
          "enum": [
            "ok",
            "violation",
            "danger"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "label",
        "bbox",
        "conf",
        "ppe",
        "zones",
        "state"
      ],
      "title": "PersonObject",
      "type": "object"
    },
    "VehicleObject": {
      "additionalProperties": false,
      "description": "A vehicle in a ``detections`` message.",
      "properties": {
        "track_id": {
          "minimum": 0,
          "title": "Track Id",
          "type": "integer"
        },
        "label": {
          "enum": [
            "vehicle",
            "forklift",
            "truck",
            "car"
          ],
          "title": "Label",
          "type": "string"
        },
        "bbox": {
          "items": {
            "type": "number"
          },
          "title": "Bbox",
          "type": "array"
        },
        "conf": {
          "title": "Conf",
          "type": "number"
        }
      },
      "required": [
        "track_id",
        "label",
        "bbox",
        "conf"
      ],
      "title": "VehicleObject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``{\"type\": \"detections\", ...}`` — at most 15 per second per camera.",
  "properties": {
    "type": {
      "const": "detections",
      "default": "detections",
      "title": "Type",
      "type": "string"
    },
    "camera_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Camera Id",
      "type": "string"
    },
    "ts": {
      "title": "Ts",
      "type": "string"
    },
    "frame_id": {
      "minimum": 0,
      "title": "Frame Id",
      "type": "integer"
    },
    "objects": {
      "items": {
        "discriminator": {
          "mapping": {
            "car": "#/$defs/VehicleObject",
            "forklift": "#/$defs/VehicleObject",
            "person": "#/$defs/PersonObject",
            "truck": "#/$defs/VehicleObject",
            "vehicle": "#/$defs/VehicleObject"
          },
          "propertyName": "label"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/PersonObject"
          },
          {
            "$ref": "#/$defs/VehicleObject"
          }
        ]
      },
      "title": "Objects",
      "type": "array"
    }
  },
  "required": [
    "type",
    "camera_id",
    "ts",
    "frame_id",
    "objects"
  ],
  "title": "DetectionsMessage",
  "type": "object"
}
