# CPU image of safety-ai (spec 7.4): python:3.11-slim, opencv-python-headless, onnxruntime, openvino.
# Build:  docker build -f docker/Dockerfile.cpu -t safety-ai:cpu .
# Run:    docker run --rm -p 8001:8001 -p 9100:9100 -v "$PWD/models:/app/models" safety-ai:cpu run --config configs/demo_file.yaml
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    YOLO_CONFIG_DIR=/app/cache/ultralytics \
    SAFETY_AI_OUTPUT__EXPOSE=true

# libglib2.0-0 is required by opencv-python-headless; make runs `make models` inside the container.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libglib2.0-0 make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Pinned, CPU-only dependency set (torch +cpu wheels, opencv-python-headless only; D-021).
COPY requirements.lock ./
RUN pip install --no-deps -r requirements.lock

COPY pyproject.toml README.md Makefile ./
COPY safety_ai ./safety_ai
COPY tools ./tools
COPY configs ./configs
COPY datasets ./datasets
COPY docker/entrypoint.sh /usr/local/bin/safety-ai-entrypoint
RUN pip install --no-deps . \
    && chmod +x /usr/local/bin/safety-ai-entrypoint \
    && useradd --create-home --uid 10001 safety \
    && mkdir -p /app/models /app/data /app/events /app/cache /app/spool /app/logs /app/reports \
    && chown -R safety:safety /app

USER safety
EXPOSE 8001 9100

HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=4 \
    CMD ["python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:9100/health', timeout=4).status == 200 else 1)"]

ENTRYPOINT ["safety-ai-entrypoint"]
CMD ["run", "--config", "configs/demo_file.yaml"]
