# CUDA image of safety-ai (spec 7.4): nvidia/cuda runtime base, torch with CUDA 12.6 wheels.
# Build:  docker build -f docker/Dockerfile.cuda -t safety-ai:cuda .
# Run:    docker run --rm --gpus all -p 8001:8001 -p 9100:9100 -v "$PWD/models:/app/models" safety-ai:cuda run --config configs/demo_file.yaml
FROM nvidia/cuda:12.6.3-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    YOLO_CONFIG_DIR=/app/cache/ultralytics \
    SAFETY_AI_OUTPUT__EXPOSE=true

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libglib2.0-0 make \
    && rm -rf /var/lib/apt/lists/*

# uv provides a standalone CPython 3.11 (the version requirements.lock was resolved for).
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /usr/local/bin/uv
RUN uv python install 3.11 && uv venv --python 3.11 /opt/venv

WORKDIR /app

# Everything from the lock except the CPU torch wheels, then torch/torchvision built for CUDA 12.6
# (their nvidia-* runtime libraries come as dependencies of the CUDA wheels).
COPY requirements.lock ./
RUN grep -v -E '^(torch|torchvision)==' requirements.lock > /tmp/requirements-nontorch.txt \
    && uv pip install --no-deps -r /tmp/requirements-nontorch.txt \
    && TORCH_VERSION="$(grep -E '^torch==' requirements.lock | sed -E 's/^torch==([^+ ]+).*/\1/')" \
    && TV_VERSION="$(grep -E '^torchvision==' requirements.lock | sed -E 's/^torchvision==([^+ ]+).*/\1/')" \
    && uv pip install --index-url https://download.pytorch.org/whl/cu126 \
        "torch==${TORCH_VERSION}" "torchvision==${TV_VERSION}" \
    && rm /tmp/requirements-nontorch.txt

COPY pyproject.toml README.md Makefile ./
COPY safety_ai ./safety_ai
COPY tools ./tools
COPY configs ./configs
COPY datasets ./datasets
COPY docker/entrypoint.sh /usr/local/bin/safety-ai-entrypoint
RUN uv pip install --no-deps . \
    && chmod +x /usr/local/bin/safety-ai-entrypoint \
    && useradd --create-home --uid 10001 safety \
    && mkdir -p /app/models /app/data /app/events /app/cache /app/spool /app/logs /app/reports \
    && chown -R safety:safety /app

USER safety
EXPOSE 8001 9100

HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=4 \
    CMD ["python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:9100/health', timeout=4).status == 200 else 1)"]

ENTRYPOINT ["safety-ai-entrypoint"]
CMD ["run", "--config", "configs/demo_file.yaml"]
